<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_bill_recurring" model="ir.ui.view">
        <field name="name">res.partner.form.bill.recurring</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="bill_recurring" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
