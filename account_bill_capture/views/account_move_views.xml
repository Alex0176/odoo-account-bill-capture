<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_bill_capture" model="ir.ui.view">
        <field name="name">account.move.form.bill.capture</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="bill_capture_mode" invisible="1"/>
                <field name="bill_ai_partner_unknown" invisible="1"/>
                <field name="bill_ai_price_pending" invisible="1"/>
                <field name="bill_ai_price_applied" invisible="1"/>
                <field name="bill_ai_state" invisible="1"/>
                <button name="action_bill_ai_read" type="object" string="Read with AI" class="btn-secondary"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'in_invoice' or state != 'draft' or bill_capture_mode == 'off'"/>
                <button name="action_bill_create_partner" type="object" string="Create supplier"
                        groups="account.group_account_invoice"
                        invisible="not bill_ai_partner_unknown or partner_id or state != 'draft'"/>
                <button name="action_bill_confirm_price_changes" type="object" string="Confirm price changes"
                        groups="account.group_account_invoice" invisible="not bill_ai_price_pending"/>
                <button name="action_bill_dismiss_price_changes" type="object" string="Dismiss price changes"
                        groups="account.group_account_invoice" invisible="not bill_ai_price_pending"/>
                <button name="action_bill_revert_price_changes" type="object" string="Undo price changes"
                        groups="account.group_account_invoice" invisible="not bill_ai_price_applied"
                        confirm="Restore the vendor prices as they were before this bill?"/>
            </xpath>
            <!-- Odoo blocks every header button of a draft while the required Bill Date is empty
                 ("Missing required fields"), which makes "Read with AI" unusable on a fresh capture.
                 With capture switched on the date is not required on the draft; posting still needs it. -->
            <xpath expr="//field[@name='invoice_date'][@required]" position="attributes">
                <attribute name="required">move_type in ('in_invoice', 'in_refund', 'in_receipt') and bill_capture_mode == 'off'</attribute>
            </xpath>
            <xpath expr="//div[@id='alerts']" position="after">
                <div class="alert alert-info" role="alert" groups="account.group_account_invoice"
                     invisible="not bill_ai_notes or move_type != 'in_invoice'">
                    <field name="bill_ai_notes" readonly="1" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='name']" position="after">
                <field name="bill_ai_product_missing" column_invisible="True"/>
                <field name="bill_ai_margin_warning" column_invisible="True"/>
                <field name="bill_ai_hint" optional="show" readonly="1" string="AI hint"/>
                <field name="bill_ai_margin_hint" optional="hide" readonly="1" string="Selling price"/>
                <button name="action_bill_create_product" type="object" icon="fa-plus" title="Create product"
                        invisible="not bill_ai_product_missing"/>
                <button name="action_bill_adjust_sale_price" type="object" icon="fa-tag" title="Adjust selling price..."
                        invisible="not bill_ai_margin_warning"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_review_list" model="ir.ui.view">
        <field name="name">account.move.review.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Bills to review" create="0" delete="0">
                <field name="partner_id"/>
                <field name="bill_ai_flags_text" string="Hints"/>
                <field name="amount_total" string="Total" sum="Total"/>
                <field name="ref"/>
                <field name="invoice_date"/>
                <field name="invoice_date_due" optional="hide"/>
                <field name="bill_ai_provider_name" string="Provider" optional="hide"/>
                <field name="bill_ai_date" string="Read at" optional="show"/>
                <field name="bill_ai_sum_mismatch" optional="hide"/>
                <field name="bill_ai_partner_unknown" optional="hide"/>
                <field name="bill_ai_tax_unclear" optional="hide"/>
                <field name="bill_ai_duplicate" optional="hide"/>
                <field name="bill_ai_product_missing" optional="hide"/>
                <field name="bill_ai_new_product" optional="hide"/>
                <field name="bill_ai_low_margin" optional="hide"/>
                <field name="bill_ai_price_pending" optional="hide"/>
                <field name="bill_ai_state" widget="badge" optional="hide"/>
                <field name="state" optional="hide"/>
                <button name="action_bill_review" type="object" string="Review and post" class="btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_move_review_search" model="ir.ui.view">
        <field name="name">account.move.review.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="ref"/>
                <filter name="sum_mismatch" string="Sum differs" domain="[('bill_ai_sum_mismatch', '=', True)]"/>
                <filter name="partner_unknown" string="Supplier unknown" domain="[('bill_ai_partner_unknown', '=', True)]"/>
                <filter name="tax_unclear" string="Tax unclear" domain="[('bill_ai_tax_unclear', '=', True)]"/>
                <filter name="duplicate" string="Possible duplicate" domain="[('bill_ai_duplicate', '=', True)]"/>
                <separator/>
                <filter name="product_missing" string="Product missing" domain="[('bill_ai_product_missing', '=', True)]"/>
                <filter name="new_product" string="New product to review" domain="[('bill_ai_new_product', '=', True)]"/>
                <filter name="low_margin" string="Selling price too low" domain="[('bill_ai_low_margin', '=', True)]"/>
                <filter name="price_pending" string="Price change to confirm" domain="[('bill_ai_price_pending', '=', True)]"/>
                <separator/>
                <filter name="failed" string="Reading failed" domain="[('bill_ai_state', '=', 'failed')]"/>
                <filter name="queued" string="Queued" domain="[('bill_ai_state', '=', 'queued')]"/>
                <group>
                    <filter name="group_partner" string="Supplier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'bill_ai_provider_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bill_review" model="ir.actions.act_window">
        <field name="name">Bills to review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'draft'), ('bill_ai_state', 'in', ('done', 'failed', 'queued'))]</field>
        <field name="search_view_id" ref="view_move_review_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_move_review_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bill waits for a review</p>
            <p>Drafts that were read by the AI show up here with their hints. Posting stays manual.</p>
        </field>
    </record>

    <record id="action_bill_capture_page" model="ir.actions.act_url">
        <field name="name">Capture a bill</field>
        <field name="url">/bill-capture</field>
        <field name="target">self</field>
    </record>
</odoo>
