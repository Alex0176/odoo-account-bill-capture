<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bill_capture_log_list" model="ir.ui.view">
        <field name="name">account.bill.capture.log.list</field>
        <field name="model">account.bill.capture.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="date"/>
                <field name="kind"/>
                <field name="state" widget="badge"/>
                <field name="move_id"/>
                <field name="origin"/>
                <field name="provider_name"/>
                <field name="product_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="old_price" optional="show"/>
                <field name="new_price" optional="show"/>
                <field name="error" optional="show"/>
                <field name="seconds" optional="hide"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bill_capture_log_form" model="ir.ui.view">
        <field name="name">account.bill.capture.log.form</field>
        <field name="model">account.bill.capture.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="state"/>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="move_id"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="provider_name"/>
                            <field name="attachment_name"/>
                            <field name="seconds"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="old_price"/>
                            <field name="new_price"/>
                            <field name="created_seller"/>
                            <field name="note"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error"><field name="error" nolabel="1"/></group>
                    <group string="Problems" invisible="not problems"><field name="problems" nolabel="1"/></group>
                    <group string="Answer of the provider (shortened)" invisible="not raw_response">
                        <field name="raw_response" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bill_capture_log_search" model="ir.ui.view">
        <field name="name">account.bill.capture.log.search</field>
        <field name="model">account.bill.capture.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_id"/>
                <field name="provider_name"/>
                <field name="product_id"/>
                <filter name="reads" string="Readings" domain="[('kind', '=', 'read')]"/>
                <filter name="prices" string="Price changes" domain="[('kind', '=', 'price')]"/>
                <filter name="created" string="Products created" domain="[('kind', '=', 'create')]"/>
                <separator/>
                <filter name="failed" string="Failed" domain="[('state', 'in', ('error', 'invalid'))]"/>
                <filter name="pending" string="Needs confirmation" domain="[('state', '=', 'pending')]"/>
                <group>
                    <filter name="group_provider" string="Provider" context="{'group_by': 'provider_name'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bill_capture_log" model="ir.actions.act_window">
        <field name="name">Bill capture log</field>
        <field name="res_model">account.bill.capture.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
