<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Does nothing unless a company is set to "Automatic". Small portions, fills drafts only. -->
    <record id="ir_cron_bill_capture" model="ir.cron">
        <field name="name">Bill capture: read queued vendor bills with AI</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="state">code</field>
        <field name="code">model._cron_bill_capture()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
